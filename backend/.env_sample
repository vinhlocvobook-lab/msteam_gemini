NODE_ENV=development
HOST=
PORT=5000
WEB_ORIGINS=http://localhost:5173

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=    

MICROSOFT_TENANT_ID=    
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_SCOPES=Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Send Chat.ReadWrite offline_access User.Read
MICROSOFT_REDIRECT_URI=http://localhost:5173/microsoft-callback.html

TEAMS_SYNC_ENABLED=false
TEAMS_SYNC_LOOKBACK_DAYS=30
TEAMS_WEBHOOK_PUBLIC_URL=
TEAMS_WEBHOOK_CLIENT_STATE=your_custom_secure_webhook_client_state_string_here

# App Custom Security Tokens (JWT & Cryptography)
APP_JWT_SECRET=your_32_character_jwt_secret_key_here
APP_JWT_REFRESH_SECRET=your_32_character_refresh_token_secret_here
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here_for_db

# Pluggable AI Subsystem (Gemini, OpenAI, Claude, Ollama, etc.)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=
